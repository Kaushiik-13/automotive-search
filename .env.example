# Copy this file to .env for local use. Never commit the real .env file.
COMPOSE_PROJECT_NAME=automotive-search

WEB_PORT=4200
API_PORT=3000
DB_HOST_PORT=5433

POSTGRES_DB=automotive_search
POSTGRES_USER=automotive_owner
POSTGRES_PASSWORD=replace_with_a_long_random_local_password
APP_DATABASE_USER=automotive_app
APP_DATABASE_PASSWORD=replace_with_a_different_long_random_password

# Owner URL is used only by the migration command. The API uses DATABASE_URL.
MIGRATION_DATABASE_URL=postgresql://automotive_owner:replace_with_the_owner_password@localhost:5433/automotive_search
DATABASE_URL=postgresql://automotive_app:replace_with_the_app_password@localhost:5433/automotive_search

ACCESS_TOKEN_SECRET=replace_with_at_least_32_random_bytes
REFRESH_TOKEN_SECRET=replace_with_a_different_32_random_bytes
ALLOWED_ORIGINS=http://localhost:4200
COOKIE_SECURE=false
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_IDLE_TTL_SECONDS=604800
REFRESH_ABSOLUTE_TTL_SECONDS=2592000
LOGIN_ACCOUNT_LIMIT=5
LOGIN_IP_LIMIT=20
LOGIN_WINDOW_SECONDS=900

# Development-only account bootstrap. Use independent random values.
# Email -> password variable map:
# global.admin@example.test       -> DEV_GLOBAL_ADMIN_PASSWORD
# orga.admin@example.test         -> DEV_ORG_A_ADMIN_PASSWORD
# orgb.admin@example.test         -> DEV_ORG_B_ADMIN_PASSWORD
# orgc.admin@example.test         -> DEV_ORG_C_ADMIN_PASSWORD
# orgd.admin@example.test         -> DEV_ORG_D_ADMIN_PASSWORD
# orgb.restricted@example.test    -> DEV_ORG_B_RESTRICTED_PASSWORD
# orga.analyst@example.test       -> DEV_ORG_A_ANALYST_PASSWORD
# orga.viewer@example.test        -> DEV_ORG_A_VIEWER_PASSWORD
# orgb.analyst@example.test       -> DEV_ORG_B_ANALYST_PASSWORD
# orgb.viewer@example.test        -> DEV_ORG_B_VIEWER_PASSWORD
# orgc.analyst@example.test       -> DEV_ORG_C_ANALYST_PASSWORD
# orgc.viewer@example.test        -> DEV_ORG_C_VIEWER_PASSWORD
# orgd.analyst@example.test       -> DEV_ORG_D_ANALYST_PASSWORD
# orgd.viewer@example.test        -> DEV_ORG_D_VIEWER_PASSWORD
DEV_GLOBAL_ADMIN_PASSWORD=replace_with_a_unique_16_plus_character_password
DEV_ORG_A_ADMIN_PASSWORD=replace_with_a_unique_16_plus_character_password
DEV_ORG_B_ADMIN_PASSWORD=replace_with_a_unique_16_plus_character_password
DEV_ORG_C_ADMIN_PASSWORD=replace_with_a_unique_16_plus_character_password
DEV_ORG_D_ADMIN_PASSWORD=replace_with_a_unique_16_plus_character_password
DEV_ORG_B_RESTRICTED_PASSWORD=replace_with_a_unique_16_plus_character_password
DEV_ORG_A_ANALYST_PASSWORD=replace_with_a_unique_16_plus_character_password
DEV_ORG_A_VIEWER_PASSWORD=replace_with_a_unique_16_plus_character_password
DEV_ORG_B_ANALYST_PASSWORD=replace_with_a_unique_16_plus_character_password
DEV_ORG_B_VIEWER_PASSWORD=replace_with_a_unique_16_plus_character_password
DEV_ORG_C_ANALYST_PASSWORD=replace_with_a_unique_16_plus_character_password
DEV_ORG_C_VIEWER_PASSWORD=replace_with_a_unique_16_plus_character_password
DEV_ORG_D_ANALYST_PASSWORD=replace_with_a_unique_16_plus_character_password
DEV_ORG_D_VIEWER_PASSWORD=replace_with_a_unique_16_plus_character_password
DEV_GLOBAL_ADMIN_EMAIL=global.admin@example.test
DEV_ORG_A_ADMIN_EMAIL=orga.admin@example.test
DEV_ORG_B_ADMIN_EMAIL=orgb.admin@example.test
DEV_ORG_C_ADMIN_EMAIL=orgc.admin@example.test
DEV_ORG_D_ADMIN_EMAIL=orgd.admin@example.test
DEV_ORG_B_RESTRICTED_EMAIL=orgb.restricted@example.test
DEV_ORG_A_ANALYST_EMAIL=orga.analyst@example.test
DEV_ORG_A_VIEWER_EMAIL=orga.viewer@example.test
DEV_ORG_B_ANALYST_EMAIL=orgb.analyst@example.test
DEV_ORG_B_VIEWER_EMAIL=orgb.viewer@example.test
DEV_ORG_C_ANALYST_EMAIL=orgc.analyst@example.test
DEV_ORG_C_VIEWER_EMAIL=orgc.viewer@example.test
DEV_ORG_D_ANALYST_EMAIL=orgd.analyst@example.test
DEV_ORG_D_VIEWER_EMAIL=orgd.viewer@example.test
